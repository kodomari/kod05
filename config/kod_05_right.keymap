#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
// #include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/bt.h>
#define ZMK_POINTING_DEFAULT_SCRL_VAL 150
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        scrl_down: scrl_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_DOWN>;
        };
        scrl_up: scrl_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>;
        };
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&scrl_up>, <&scrl_down>;
        };
    };
  keymap {
    compatible = "zmk,keymap";

    // col-offset方式: 各行、右手7列(central, offset0)→左手7列(peripheral, offset7)の順。
    // 従来の「左手35キー block→右手35キー block」の並びから、行単位の交互配置に変更。
    default_layer {
    sensor-bindings = <&scroll_encoder>;
      bindings = <
        // row0: 右7 + 左7
        &kp G     &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp ESC   &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp RET
        // row1
        &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp DOWN
        // row2
        &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp APOS  &kp RET   &kp LCTRL &kp A     &kp S     &kp D     &kp F     &kp G     &kp LEFT
        // row3
        &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT &kp LSHFT &kp Z     &kp X     &kp C     &kp V     &kp B     &kp RIGHT
        // row4
        &mkp LCLK &mkp MCLK &mkp RCLK &kp SPACE &kp BSLH  &kp PSCRN &kp BSPC  &mo 1     &kp LGUI  &kp LALT  &kp SPACE &kp DEL   &kp N6    &kp UP
      >;
    };

    function_layer {
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
      bindings = <
        // row0
        &trans    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp TILDE &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &trans
        // row1
        &trans    &trans    &trans    &trans    &trans    &trans    &trans    &bt BT_CLR    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans
        // row2
        &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
        // row3
        &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
        // row4
        &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &kp F6    &trans
      >;
    };
    combos {
        compatible = "zmk,combos";

        combo_right_boot {
            timeout-ms = <50>;
            /* 旧: <41 68> = 右手のEQUAL・PSCRN。新配置での同じ2キーのポジション番号に更新 */
            key-positions = <6 61>;
            bindings = <&bootloader>;
        };
    };
  };
};
